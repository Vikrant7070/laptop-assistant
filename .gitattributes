# Large binaries go to Git LFS (roadmap R3 step 1a). History is rewritten later (step 1b).
*.vrm filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# ...except the reaction clips: 320 KB in all, read at runtime and by tests/test_sfx.py (CI checks out without LFS).
sounds/*.wav -filter -diff -merge -text
